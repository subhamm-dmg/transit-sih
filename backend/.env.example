# Copy this file to .env and adjust as needed.
# The backend runs fully offline with defaults - none of these are
# required tonight.

APP_NAME=transit-sih-backend
ENV=development

# Comma-separated list of allowed CORS origins for local frontend dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Which adapter mode each service uses. "mock" = offline deterministic
# data (tonight). Switch to "live"/"gtfs"/etc. tomorrow once real
# integrations are wired up.
# ROUTING_MODE: "mock" (default, offline) | "google" (stub - not yet
# implemented, raises NotImplementedError if selected).
ROUTING_MODE=mock
PREDICTION_MODE=mock
TRAFFIC_MODE=mock
WEATHER_MODE=mock

# Real API keys go here tomorrow. Never commit real values.
WEATHER_API_KEY=
TRAFFIC_API_KEY=
# Not used yet - GoogleRoutesProvider is a stub (not implemented).
GOOGLE_ROUTES_API_KEY=

# Path to GTFS data files, once available.
GTFS_DATA_PATH=
